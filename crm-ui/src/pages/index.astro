<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#6e3e34" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="CRM" />
    <title>CRM Extensiones Guatemala</title>
    <link rel="manifest" href="/crm/manifest.webmanifest" />
    <link rel="icon" href="/crm/logo.png" />
    <script is:inline>
      try {
        const guardado = localStorage.getItem("color-scheme");
        if (guardado === "dark" || guardado === "light") {
          document.querySelector('meta[name="color-scheme"]').content = guardado;
        }
      } catch {}
    </script>
  </head>
  <body>
    <header class="barra">
      <a class="marca" href="/crm">
        <img src="/crm/logo.png" alt="Extensiones Guatemala, Human Hair Extensions" width="622" height="637" />
      </a>
      <button type="button" id="tema" class="tema">Modo oscuro</button>
    </header>
    <main id="acceso">
      <section id="entrar" class="tarjeta">
        <h1>Entra al CRM</h1>
        <form id="forma-entrar">
          <label for="correo-entrar">Correo de Gmail</label>
          <input id="correo-entrar" name="email" type="email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" required />
          <label for="clave-entrar">Contraseña</label>
          <input id="clave-entrar" name="clave" type="password" autocomplete="current-password" minlength="8" required />
          <p class="error" id="error-entrar" hidden></p>
          <button type="submit">Entrar</button>
        </form>
        <p class="enlaces">
          <button type="button" id="ir-registro" class="texto">Crear acceso</button>
          <button type="button" id="ir-recuperar" class="texto">Perdí mi contraseña</button>
        </p>
      </section>
      <section id="registro" class="tarjeta" hidden>
        <h1>Registro del equipo</h1>
        <p>Escribe tu Gmail. Te enviamos un enlace para crear la contraseña.</p>
        <form id="forma-registro">
          <label for="correo-registro">Correo de Gmail</label>
          <input id="correo-registro" name="email" type="email" autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" required />
          <p class="error" id="error-registro" hidden></p>
          <p class="ok" id="ok-registro" hidden></p>
          <button type="submit">Enviar enlace</button>
        </form>
        <button type="button" class="texto" data-volver>Volver a entrar</button>
      </section>
      <section id="olvido" class="tarjeta" hidden>
        <h1>Perdí mi contraseña</h1>
        <p>Te enviamos un enlace al Gmail registrado para elegir una contraseña nueva.</p>
        <form id="forma-olvido">
          <label for="correo-olvido">Correo de Gmail</label>
          <input id="correo-olvido" name="email" type="email" autocomplete="username" inputmode="email" autocapitalize="none" spellcheck="false" required />
          <p class="error" id="error-olvido" hidden></p>
          <p class="ok" id="ok-olvido" hidden></p>
          <button type="submit">Enviar recuperación</button>
        </form>
        <button type="button" class="texto" data-volver>Volver a entrar</button>
      </section>
      <section id="nueva" class="tarjeta" hidden>
        <h1 id="titulo-nueva">Crea tu contraseña</h1>
        <form id="forma-nueva">
          <label for="clave-nueva">Contraseña nueva</label>
          <input id="clave-nueva" name="clave" type="password" autocomplete="new-password" minlength="8" required />
          <p class="ayuda">Mínimo 8 caracteres.</p>
          <p class="error" id="error-nueva" hidden></p>
          <p class="ok" id="ok-nueva" hidden></p>
          <button type="submit">Guardar contraseña</button>
        </form>
      </section>
    </main>
    <main id="trabajo" hidden>
      <section class="cuentas" aria-label="Consumo">
        <form id="forma-presupuesto">
          <p class="cuenta-titulo">OpenAI</p>
          <p class="cuenta-numero"><strong id="disponible">$0.0000</strong><span> disponibles</span></p>
          <p class="ayuda">Gastados <span id="gastado">$0.0000</span> de <span id="presupuesto-vista">$0.0000</span>. Se descuenta con los tokens de cada respuesta.</p>
          <label for="presupuesto">Presupuesto recargado (USD)</label>
          <input id="presupuesto" name="usd" type="number" inputmode="decimal" min="0" max="100000" step="0.01" autocomplete="off" required />
          <p class="error" id="error-presupuesto" hidden></p>
          <button type="submit">Guardar presupuesto</button>
        </form>
        <div class="cuenta">
          <p class="cuenta-titulo">WhatsApp este mes</p>
          <p class="cuenta-numero"><strong id="wa-usados">0</strong><span> de 1,000 gratis</span></p>
          <p class="ayuda">Mensajes salientes entregados. Los que entran no se cuentan.</p>
          <p id="wa-alerta" class="alerta" hidden role="alert"></p>
        </div>
      </section>
      <label class="bot encendido" id="bot">
        <span id="bot-texto">Bot encendido. Toca para apagarlo.</span>
        <span class="interruptor">
          <input id="bot-switch" type="checkbox" switch checked />
          <span class="pista" aria-hidden="true"><span class="lado off">OFF</span><span class="lado on">ON</span></span>
        </span>
      </label>
      <section class="cifras" aria-label="Mensajes">
        <p><strong id="entrada">0</strong><span> entraron</span></p>
        <p><strong id="salida">0</strong><span> salieron</span></p>
      </section>
      <div class="cuerpo">
        <section class="lista">
          <div class="pestanas" role="tablist" aria-label="Estado de los chats">
            <button type="button" id="tab-pendientes" role="tab" aria-selected="true">Pendientes</button>
            <button type="button" id="tab-respondidos" role="tab" aria-selected="false">Respondidos</button>
            <button type="button" id="tab-bot" role="tab" aria-selected="false">Bot</button>
            <button type="button" id="tab-persona" role="tab" aria-selected="false">Persona</button>
          </div>
          <p id="nota-seccion" class="ayuda" hidden></p>
          <button type="button" id="borrar-todos" class="peligro">Eliminar todos los mensajes</button>
          <div id="hilos"></div>
        </section>
        <section class="chat" id="chat" hidden>
          <div class="chat-cabeza">
            <button type="button" id="volver" class="volver">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
                <path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span>Conversaciones</span>
            </button>
            <h2 id="titulo-chat">Conversación</h2>
            <button type="button" id="borrar-abierto" class="texto">Eliminar chat</button>
          </div>
          <div id="linea" class="linea"></div>
          <form id="forma-envio">
            <label for="texto">Respuesta</label>
            <textarea id="texto" name="texto" rows="3" maxlength="4000"></textarea>
            <label class="adjunto" for="archivo">Adjuntar imagen, audio o PDF</label>
            <input id="archivo" name="archivo" type="file" accept="image/jpeg,image/png,image/webp,audio/*,application/pdf,.pdf" />
            <p class="error" id="error-envio" hidden></p>
            <button type="submit">Enviar por WhatsApp</button>
          </form>
        </section>
      </div>
      <div class="pie">
        <button type="button" id="avisos" class="texto">Activar avisos de mensajes nuevos</button>
        <button type="button" id="salir" class="texto">Salir</button>
      </div>
    </main>
    <dialog id="confirmar" aria-labelledby="confirmar-titulo" closedby="any">
      <h2 id="confirmar-titulo">Eliminar esta conversación</h2>
      <p id="confirmar-detalle"></p>
      <form method="dialog">
        <button value="cancelar" autofocus>Cancelar</button>
        <button value="eliminar" id="confirmar-accion">Eliminar</button>
      </form>
    </dialog>
    <style>
      :root {
        color-scheme: light dark;
        --papel: light-dark(#fbf7f4, #1c1412);
        --tinta: light-dark(#3a2420, #f6ebe6);
        --suave: light-dark(#6e3e34, #e4c2b4);
        --linea: light-dark(#eadfd6, #3a2a26);
        --oro: light-dark(#8d5344, #e0b197);
        --panel: light-dark(#fffdfb, #261c19);
        --listo: light-dark(#1f6b45, #b7d7c4);
        --boton: light-dark(#6e3e34, #e0b197);
        --boton-tinta: light-dark(#fffdfb, #1c1412);
        font-family: "Segoe UI", system-ui, sans-serif;
        background: var(--papel);
        color: var(--tinta);
        accent-color: var(--oro);
        scrollbar-color: var(--oro) var(--papel);
      }
      :root:has(> head > meta[name="color-scheme"][content="dark"]) { color-scheme: dark; }
      :root:has(> head > meta[name="color-scheme"][content="light"]) { color-scheme: light; }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; min-height: 100dvh; }
      ::selection { background: light-dark(#f0d2c4, #6e3e34); color: light-dark(#3a2420, #fffdfb); }
      :focus-visible { outline: 2px solid var(--oro); outline-offset: 3px; }
      button, input, textarea { font: inherit; color: inherit; }
      button { cursor: pointer; }
      .barra { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.65rem 1rem; border-bottom: 1px solid var(--linea); position: sticky; inset-block-start: 0; z-index: 2; background: var(--papel); }
      .marca img { display: block; width: 4.5rem; height: auto; background: transparent; }
      @media (prefers-color-scheme: dark) {
        .marca img { filter: brightness(0) invert(1); }
      }
      :root:has(> head > meta[name="color-scheme"][content="light"]) .marca img { filter: none; }
      :root:has(> head > meta[name="color-scheme"][content="dark"]) .marca img { filter: brightness(0) invert(1); }
      .tema, .texto { background: transparent; border: 1px solid var(--linea); border-radius: 999px; padding: 0.55rem 0.9rem; }
      main { padding: 1rem; }
      .tarjeta { max-width: 28rem; margin: 1.5rem auto; display: grid; gap: 0.75rem; }
      h1, h2 { font-weight: 560; letter-spacing: -0.03em; line-height: 1.1; margin: 0; }
      form { display: grid; gap: 0.45rem; }
      label { font-size: 0.92rem; }
      input, textarea { width: 100%; border: 1px solid var(--linea); background: var(--panel); border-radius: 0.7rem; padding: 0.75rem; }
      button[type="submit"] { border: 0; border-radius: 0.8rem; background: var(--boton); color: var(--boton-tinta); padding: 0.9rem 1rem; font-weight: 650; }
      .cuentas { display: grid; gap: 0.75rem; margin-bottom: 0.75rem; }
      .cuentas form, .cuenta { display: grid; gap: 0.35rem; padding: 0.85rem 0.9rem; border: 1px solid var(--linea); border-radius: 1rem; background: var(--panel); }
      .cuenta-titulo { margin: 0; font-size: 0.95rem; font-weight: 650; color: var(--tinta); }
      .cuenta-numero { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem; font-variant-numeric: tabular-nums; }
      .cuenta-numero strong { font-size: 1.45rem; font-weight: 650; letter-spacing: -0.03em; line-height: 1; }
      .alerta { margin: 0.2rem 0 0; padding: 0.7rem 0.75rem; border: 1px solid light-dark(#8d2b24, #ffb4ab); border-radius: 0.7rem; background: light-dark(#f8e4df, #4a2824); color: light-dark(#6e241e, #ffd7d1); font-weight: 650; }
      .bot {
        --bot-fondo: var(--boton);
        --bot-tinta: var(--boton-tinta);
        display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
        width: 100%; min-height: 3.25rem; margin-bottom: 0.75rem; padding: 0.85rem 0.9rem;
        border: 0; border-radius: 0.8rem; background: var(--bot-fondo); color: var(--bot-tinta);
        font-weight: 650; text-align: start; text-wrap: balance; cursor: pointer;
        transition: background-color 160ms ease, color 160ms ease;
      }
      .bot:has(#bot-switch:checked) { --bot-fondo: #1f6b45; --bot-tinta: #f4fff8; background-color: #1f6b45; color: #f4fff8; }
      .bot:focus-within { outline: 3px solid var(--oro); outline-offset: 3px; }
      .interruptor { position: relative; display: grid; flex: 0 0 auto; inline-size: 5.6rem; block-size: 1.9rem; }
      .interruptor input { appearance: none; margin: 0; padding: 0; grid-area: 1 / 1; inline-size: 100%; block-size: 100%; border: 0; border-radius: 999px; background: transparent; cursor: pointer; }
      .interruptor input:disabled { opacity: 1; cursor: wait; }
      .pista { grid-area: 1 / 1; display: grid; grid-template-columns: 1fr 1fr; align-items: center; pointer-events: none; border-radius: 999px; background: rgb(0 0 0 / 0.32); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.04em; }
      .lado { text-align: center; border-radius: 999px; padding: 0.28rem 0; }
      .bot:not(:has(#bot-switch:checked)) .lado.off { background: #fff; color: #3a2420; }
      .bot:has(#bot-switch:checked) .lado.on { background: #fff; color: #145c38; }
      @supports not selector(:has(*)) {
        .bot.encendido { --bot-fondo: #1f6b45; --bot-tinta: #f4fff8; background-color: #1f6b45; color: #f4fff8; }
        .bot:not(.encendido) .lado.off { background: #fff; color: #3a2420; }
        .bot.encendido .lado.on { background: #fff; color: #145c38; }
      }
      @media (prefers-reduced-motion: reduce) { .bot { transition: none; } }
      .enlaces { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .error { color: light-dark(#8d2b24, #ffb4ab); margin: 0; }
      .ok, .ayuda { color: var(--suave); margin: 0; }
      .peligro { justify-self: start; margin: 0.35rem 0 0.55rem; border: 1px solid light-dark(#8d2b24, #ffb4ab); background: transparent; color: light-dark(#8d2b24, #ffb4ab); border-radius: 999px; padding: 0.45rem 0.8rem; }
      .cifras { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin: 0.9rem 0 1rem; }
      .cifras p { margin: 0; display: flex; flex-direction: column; gap: 0.1rem; min-inline-size: 0; }
      .cifras strong { font-size: 1.75rem; font-weight: 640; font-variant-numeric: tabular-nums; letter-spacing: -0.03em; line-height: 1; }
      .cifras span { color: var(--suave); }
      .pestanas { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; margin-bottom: 0.35rem; padding: 0.25rem; background: var(--panel); border: 1px solid var(--linea); border-radius: 1rem; }
      .pestanas button { border: 0; background: transparent; border-radius: 999px; padding: 0.55rem 0.7rem; }
      .pestanas button[aria-selected="true"] { background: var(--boton); color: var(--boton-tinta); }
      :global(.hilo) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 0.45rem; inline-size: 100%; min-inline-size: 0; border-block-end: 1px solid var(--linea); background: transparent; }
      :global(.hilo-abrir) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; column-gap: 0.75rem; row-gap: 0.2rem; min-inline-size: 0; inline-size: 100%; text-align: start; padding: 0.9rem 0.2rem; border: 0; background: transparent; color: inherit; }
      :global(.hilo.activo) { background: var(--panel); }
      @media (hover: hover) {
        :global(.hilo:hover) { background: var(--panel); }
      }
      :global(.hilo-borrar) { border: 1px solid var(--linea); background: transparent; color: light-dark(#8d2b24, #ffb4ab); border-radius: 999px; padding: 0.4rem 0.7rem; font-size: 0.85rem; }
      :global(.hilo-tel) { font-weight: 650; font-variant-numeric: tabular-nums; letter-spacing: -0.01em; }
      :global(.hilo-vista) { grid-column: 1 / -1; min-inline-size: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--suave); }
      :global(.estado) { font-size: 0.78rem; font-weight: 650; }
      :global(.estado-pendiente) { color: light-dark(#6e3e34, #f0d2c4); }
      :global(.estado-respondido) { color: light-dark(#1b5c3c, #b7d7c4); }
      .chat-cabeza { display: flex; flex-direction: column; align-items: flex-start; gap: 0.7rem; }
      .volver { display: inline-flex; align-items: center; gap: 0.35rem; min-block-size: 2.75rem; padding: 0.35rem 0.9rem 0.35rem 0.45rem; border: 1px solid var(--linea); border-radius: 999px; background: var(--panel); color: var(--tinta); font-weight: 650; }
      .volver svg { flex: none; }
      .linea { display: flex; flex-direction: column; gap: 0.55rem; max-block-size: 46dvh; overflow: auto; margin: 0.85rem 0; padding-inline-end: 0.15rem; }
      :global(.burbuja) { margin: 0; max-inline-size: 85%; padding: 0.65rem 0.8rem; border-radius: 0.9rem; background: var(--panel); line-height: 1.4; overflow-wrap: anywhere; }
      :global(.burbuja.mio) { margin-inline-start: auto; background: light-dark(#f3e4dc, #3a2a26); }
      :global(.burbuja a) { color: inherit; }
      :global(.quien) { display: block; margin-block-end: 0.2rem; font-size: 0.75rem; font-weight: 650; color: var(--suave); }
      :global(.ayuda) { color: var(--suave); margin: 0.8rem 0; }
      .adjunto { justify-self: start; border: 1px solid var(--linea); border-radius: 999px; padding: 0.45rem 0.8rem; }
      input[type="file"] { position: absolute; inline-size: 1px; block-size: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
      .pie { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-block-start: 1.25rem; }
      dialog { border: 1px solid var(--linea); border-radius: 1rem; background: var(--panel); color: var(--tinta); padding: 1.1rem; max-inline-size: min(24rem, calc(100% - 2rem)); }
      dialog:modal { overscroll-behavior: contain; }
      dialog::backdrop { background: light-dark(rgb(58 36 32 / 0.35), rgb(0 0 0 / 0.55)); overflow: hidden; overscroll-behavior: contain; }
      dialog p { margin: 0.6rem 0 0; }
      dialog form { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem; }
      dialog button[value="eliminar"] { border: 0; border-radius: 0.8rem; padding: 0.7rem 1rem; background: light-dark(#8d2b24, #ffb4ab); color: light-dark(#fffdfb, #1c1412); }
      @media (min-width: 960px) {
        .cuerpo { display: grid; grid-template-columns: minmax(18rem, 22rem) minmax(0, 1fr); gap: 0; align-items: start; }
        #chat { display: block; padding-inline-start: 1.25rem; border-inline-start: 1px solid var(--linea); }
        #volver { display: none; }
      }
      @media (max-width: 959px) {
        body.en-chat .lista,
        body.en-chat .cuentas,
        body.en-chat .bot,
        body.en-chat .cifras,
        body.en-chat .pie { display: none; }
        body.en-chat #chat { display: block; }
      }
    </style>
    <script>
      import "../cliente.ts";
    </script>
  </body>
</html>
